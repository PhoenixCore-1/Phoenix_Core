type KpiCardProps = {
  value: string | number
  label: string
  secondary?: string
  onClick: () => void
  disabled?: boolean
}

function KpiCard({
  value,
  label,
  secondary,
  onClick,
  disabled = false,
}: KpiCardProps) {
  return (
    <button
      type="button"
      className={`kpi-card ${
