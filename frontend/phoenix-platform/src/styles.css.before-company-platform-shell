/* =========================================================
   PHOENIX CORE PLATFORM
   GLOBAL STYLES
   ========================================================= */

:root {
  font-family: "Segoe UI", Inter, Arial, sans-serif;
  color: #0b1d35;
  background: #eef3f8;
  font-synthesis: none;
  text-rendering: optimizeLegibility;

  --navy: #071b34;
  --navy-2: #0b2748;
  --blue: #1769d2;
  --blue-dark: #0d55b0;
  --blue-soft: #eaf3ff;

  --ink: #0b1d35;
  --muted: #60738b;
  --muted-2: #8091a5;

  --surface: #ffffff;
  --surface-soft: #f7f9fc;
  --border: #d8e1eb;
  --border-light: #e8edf3;

  --success: #16845b;
  --warning: #a96d00;

  --shadow-sm: 0 2px 8px rgba(7, 27, 52, 0.06);
  --shadow-md: 0 8px 24px rgba(7, 27, 52, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
}

body,
#root {
  margin: 0;
  min-height: 100vh;
}

body {
  background: #eef3f8;
  color: var(--ink);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.shell {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  min-height: 100vh;
  background: #eef3f8;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.shell > aside {
  position: sticky;
  top: 0;
  height: 100vh;

  display: flex;
  flex-direction: column;

  padding: 24px 16px;

  background: var(--navy);
  color: #ffffff;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;

  padding: 2px 10px 22px;
}

.brand img {
  width: 36px;
  height: 36px;
  object-fit: contain;
}

.brand strong {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.platform-title {
  padding: 0 10px 14px;

  color: #8fa7c2;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.shell aside nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.shell aside nav button {
  width: 100%;

  border: 0;
  border-radius: 8px;

  padding: 11px 12px;

  background: transparent;
  color: #c4d2e1;

  text-align: left;
  font-size: 14px;
  font-weight: 500;

  transition:
    background 140ms ease,
    color 140ms ease;
}

.shell aside nav button:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #ffffff;
}

.shell aside nav button.active {
  background: #173c65;
  color: #ffffff;
  font-weight: 600;
}

.side-foot {
  margin-top: auto;
  padding: 18px 10px 4px;

  color: #6f87a3;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

/* =========================================================
   MAIN AREA
   ========================================================= */

.shell > main {
  min-width: 0;
  min-height: 100vh;
  background: #eef3f8;
}

.shell > main > header {
  min-height: 76px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 14px 34px;

  background: #ffffff;
  border-bottom: 1px solid var(--border);
}

.shell > main > header h2 {
  margin: 3px 0 0;

  color: var(--ink);
  font-size: 17px;
  font-weight: 700;
}

.account {
  display: flex;
  align-items: center;
  gap: 18px;

  color: #53677e;
  font-size: 13px;
}

.account button {
  border: 1px solid var(--border);
  border-radius: 7px;

  padding: 7px 12px;

  background: #ffffff;
  color: var(--ink);

  font-size: 12px;
  font-weight: 600;
}

.account button:hover {
  background: var(--surface-soft);
}

/* =========================================================
   CONTENT
   ========================================================= */

.content {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;

  padding: 32px 34px 48px;
}

.hero {
  margin-bottom: 24px;
}

.hero h1 {
  margin: 7px 0 8px;

  color: var(--ink);
  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
}

.hero p {
  margin: 0;
}

.eyebrow {
  display: inline-block;

  color: #50759d;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.muted {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.55;
}

/* =========================================================
   SYSTEM HOME DASHBOARD
   ========================================================= */

.system-home {
  width: 100%;
}

.system-home-header {
  margin-bottom: 24px;
}

.system-home-header h1 {
  margin: 7px 0 8px;

  font-size: 30px;
  line-height: 1.2;
}

.system-home-header p {
  margin: 0;
  color: var(--muted);
}

/* KPI GRID */

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;

  margin-bottom: 22px;
}

.kpi-card {
  position: relative;

  min-height: 150px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 20px;

  border: 1px solid var(--border);
  border-radius: 10px;

  background: var(--surface);

  box-shadow: var(--shadow-sm);

  text-align: left;

  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    border-color 140ms ease;
}

.kpi-card:hover {
  transform: translateY(-2px);

  border-color: #b8cce2;
  box-shadow: var(--shadow-md);
}

.kpi-card:focus-visible {
  outline: 3px solid rgba(23, 105, 210, 0.22);
  outline-offset: 2px;
}

.kpi-card-label {
  color: #58718e;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.kpi-card-value {
  margin-top: 12px;

  color: var(--ink);
  font-size: 31px;
  line-height: 1;
  font-weight: 700;
}

.kpi-card-secondary {
  margin-top: 10px;

  color: var(--muted);
  font-size: 12px;
}

.kpi-card-action {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 16px;

  color: var(--blue);
  font-size: 12px;
  font-weight: 600;
}

.kpi-card-action::after {
  content: "â†’";
  font-size: 15px;
}

.kpi-card.is-unavailable {
  cursor: default;
}

.kpi-card.is-unavailable:hover {
  transform: none;
  box-shadow: var(--shadow-sm);
}

.kpi-card.is-unavailable .kpi-card-value {
  color: #71849a;
}

/* =========================================================
   DASHBOARD PANELS
   ========================================================= */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;

  margin-bottom: 20px;
}

.dashboard-panel,
.panel {
  border: 1px solid var(--border);
  border-radius: 10px;

  background: var(--surface);

  box-shadow: var(--shadow-sm);
}

.dashboard-panel {
  padding: 22px;
}

.dashboard-panel-wide {
  grid-column: 1 / -1;
}

.panel {
  padding: 22px;
  margin-bottom: 20px;
}

.panel h3,
.dashboard-panel h3 {
  margin: 0 0 16px;

  color: var(--ink);
  font-size: 15px;
  font-weight: 700;
}

.panel p {
  line-height: 1.5;
}

/* PANEL HEADER */

.panel-header,
.dashboard-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 16px;
}

.panel-header h3,
.dashboard-panel-header h3 {
  margin: 0;
}

.panel-header p,
.dashboard-panel-header p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* =========================================================
   PLATFORM STATUS
   ========================================================= */

.platform-status {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.status-item {
  padding: 14px;

  border: 1px solid var(--border-light);
  border-radius: 8px;

  background: var(--surface-soft);
}

.status-item-label {
  display: block;

  margin-bottom: 5px;

  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.status-item-value {
  color: var(--ink);
  font-size: 14px;
  font-weight: 700;
}

.status-online {
  color: var(--success);
}

/* =========================================================
   RECENT COMPANIES
   ========================================================= */

.recent-companies {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.recent-company {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 12px 0;

  border-bottom: 1px solid var(--border-light);
}

.recent-company:last-child {
  border-bottom: 0;
}

.recent-company-name {
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
}

.recent-company-code {
  margin-top: 3px;

  color: var(--muted);
  font-size: 11px;
}

.status-badge {
  flex: 0 0 auto;

  padding: 5px 8px;

  border-radius: 999px;

  background: #e9f7f1;
  color: var(--success);

  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

/* =========================================================
   RECENT ACTIVITY
   ========================================================= */

.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 12px 0;

  border-bottom: 1px solid var(--border-light);
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-dot {
  width: 8px;
  height: 8px;
  margin-top: 5px;

  flex: 0 0 auto;

  border-radius: 50%;
  background: var(--blue);
}

.activity-text {
  color: var(--ink);
  font-size: 13px;
  line-height: 1.45;
}

.activity-time {
  margin-top: 3px;

  color: var(--muted-2);
  font-size: 11px;
}

/* =========================================================
   LINKS / ACTIONS
   ========================================================= */

.text-button,
.panel-link,
.view-all {
  border: 0;
  padding: 0;

  background: transparent;
  color: var(--blue);

  font-size: 12px;
  font-weight: 700;
}

.text-button:hover,
.panel-link:hover,
.view-all:hover {
  color: var(--blue-dark);
  text-decoration: underline;
}

/* =========================================================
   FORMS
   ========================================================= */

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

input,
select,
textarea {
  min-height: 40px;

  border: 1px solid #cbd7e4;
  border-radius: 7px;

  padding: 9px 11px;

  background: #ffffff;
  color: var(--ink);

  outline: none;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(23, 105, 210, 0.10);
}

.row input {
  min-width: 190px;
}

.row > button,
.panel > button {
  min-height: 40px;

  border: 0;
  border-radius: 7px;

  padding: 9px 16px;

  background: var(--blue);
  color: #ffffff;

  font-size: 13px;
  font-weight: 700;
}

.row > button:hover,
.panel > button:hover {
  background: var(--blue-dark);
}

.small-btn {
  min-height: 32px;

  margin: 6px 6px 0 0;

  border: 1px solid #c8d7e7;
  border-radius: 6px;

  padding: 6px 10px;

  background: #ffffff;
  color: var(--blue);

  font-size: 11px;
  font-weight: 600;
}

.small-btn:hover {
  background: var(--blue-soft);
}

/* =========================================================
   LISTS
   ========================================================= */

.list {
  display: flex;
  flex-direction: column;
  gap: 6px;

  padding: 15px 0;

  border-bottom: 1px solid var(--border-light);
}

.list:last-child {
  border-bottom: 0;
}

.list strong {
  color: var(--ink);
  font-size: 14px;
}

.list span {
  color: var(--muted);
  font-size: 12px;
}

/* =========================================================
   PLACEHOLDER PAGES
   ========================================================= */

.hero + .panel {
  margin-top: 20px;
}

/* =========================================================
   LOGIN
   ========================================================= */

.login-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px;

  background:
    radial-gradient(
      circle at 50% 20%,
      #17375d 0,
      #071b34 38%,
      #020b17 100%
    );
}

.login-card-new {
  width: 100%;
  max-width: 520px;

  display: grid;
  grid-template-columns: 0.9fr 1.1fr;

  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.30);
}

.login-brand-new {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 500px;

  padding: 42px;

  background: #f5f8fc;
}

.login-brand-new img {
  width: 130px;
  height: 130px;

  object-fit: contain;

  margin-bottom: 24px;
}

.login-brand-new h1 {
  margin: 0;

  color: var(--navy);
  font-size: 18px;
  letter-spacing: 0.08em;
  text-align: center;
}

.login-brand-new p {
  margin: 8px 0 0;

  color: var(--muted);
  font-size: 12px;
  text-align: center;
}

.login-form-new {
  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 48px;
}

.login-form-new h2 {
  margin: 0 0 7px;

  color: var(--ink);
  font-size: 25px;
}

.login-form-new > p {
  margin: 0 0 28px;

  color: var(--muted);
  font-size: 13px;
}

.login-form-new form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.login-form-new label {
  display: flex;
  flex-direction: column;
  gap: 7px;

  color: var(--ink);
  font-size: 12px;
  font-weight: 700;
}

.login-form-new input {
  width: 100%;
  min-height: 44px;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 62px;
}

.password-field button {
  position: absolute;
  top: 50%;
  right: 8px;

  transform: translateY(-50%);

  border: 0;
  padding: 5px 7px;

  background: transparent;
  color: var(--blue);

  font-size: 11px;
  font-weight: 700;
}

.remember-new {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;

  gap: 8px !important;

  color: var(--muted) !important;
  font-weight: 500 !important;
}

.remember-new input {
  width: 15px;
  min-height: 15px;
}

.login-submit-new {
  width: 100%;
  min-height: 44px;

  border: 0;
  border-radius: 7px;

  background: var(--blue);
  color: #ffffff;

  font-size: 13px;
  font-weight: 700;
}

.login-submit-new:hover {
  background: var(--blue-dark);
}

.login-footer-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  margin-top: 28px;

  color: #8a9aab;
  font-size: 10px;
}

/* =========================================================
   CENTER / LOADING
   ========================================================= */

.center {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eef3f8;
  color: var(--muted);

  font-size: 14px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {
  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .platform-status {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .shell {
    grid-template-columns: 1fr;
  }

  .shell > aside {
    position: static;
    height: auto;

    padding: 16px;
  }

  .shell aside nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .side-foot {
    margin-top: 12px;
  }

  .shell > main > header {
    padding: 14px 20px;
  }

  .content {
    padding: 24px 20px 40px;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-panel-wide {
    grid-column: auto;
  }

  .login-card-new {
    grid-template-columns: 1fr;
    max-width: 520px;
  }

  .login-brand-new {
    min-height: 220px;
    padding: 28px;
  }

  .login-brand-new img {
    width: 80px;
    height: 80px;
    margin-bottom: 12px;
  }
}

@media (max-width: 560px) {
  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .platform-status {
    grid-template-columns: 1fr;
  }

  .shell aside nav {
    grid-template-columns: 1fr;
  }

  .account > span {
    display: none;
  }

  .hero h1,
  .system-home-header h1 {
    font-size: 25px;
  }

  .login-form-new {
    padding: 30px 24px;
  }
}
/* =========================================================
   LOGIN LAYOUT CORRECTION
   Restores the current Login JSX structure without changing
   authentication or component structure.
   ========================================================= */

.login-card-new {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 520px;
  overflow: hidden;
}

.login-header-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  min-height: 150px;
  padding: 28px 40px;
  background: #f5f8fc;
}

.login-header-brand img {
  width: 90px;
  height: 90px;
  object-fit: contain;
  flex: 0 0 auto;
}

.brand-divider {
  width: 1px;
  height: 58px;
  background: #cbd7e4;
}

.brand-title {
  color: var(--navy);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.5;
}

.brand-title span {
  display: block;
}

.login-heading {
  padding: 30px 48px 0;
}

.login-heading h1 {
  margin: 0 0 7px;
  color: var(--ink);
  font-size: 25px;
}

.login-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.login-form-new {
  padding: 28px 48px 0;
}

.login-footer-new {
  padding-bottom: 30px;
}

@media (max-width: 820px) {
  .login-card-new {
    max-width: 520px;
  }

  .login-header-brand {
    min-height: 120px;
    padding: 22px;
  }

  .login-header-brand img {
    width: 70px;
    height: 70px;
  }

  .login-heading {
    padding: 26px 30px 0;
  }

  .login-form-new {
    padding: 24px 30px 0;
  }
}
/* =========================================================
   COMPANY DETAIL HIERARCHY
   ========================================================= */

.company-status-block {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 20px;
}

.company-status-value {
  font-size: 14px;
  letter-spacing: 0.05em;
}

.company-status-action {
  margin-top: 12px;
}

.section-heading {
  margin-bottom: 20px;
}

.section-heading h3 {
  margin: 4px 0 0;
}

.section-heading .muted {
  margin-top: 6px;
}

.company-overview-panel,
.business-modules-panel {
  margin-top: 18px;
}

.company-overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.company-overview-grid > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.field-label {
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.business-modules-panel .list {
  align-items: center;
  gap: 16px;
}

.business-modules-panel .list > strong {
  min-width: 150px;
}

.business-modules-panel .list > span:nth-child(3) {
  font-weight: 700;
  letter-spacing: 0.04em;
}

@media (max-width: 720px) {
  .company-overview-grid {
    grid-template-columns: 1fr;
  }

  .business-modules-panel .list {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* =========================================================
   BUSINESS MODULE ROW
   ========================================================= */

.module-row {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) auto auto;
  align-items: center;
  gap: 28px;
  padding: 18px 0;
  border-top: 1px solid #e4eaf1;
}

.module-row:first-of-type {
  border-top: 0;
}

.module-row > strong {
  min-width: 0;
}

.module-row > span {
  white-space: nowrap;
}

.module-row > div {
  display: flex;
  justify-content: flex-end;
}

.module-row .small-btn {
  white-space: nowrap;
}

@media (max-width: 760px) {
  .module-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .module-row > div {
    justify-content: flex-start;
  }
}

/* =========================================================
   COMPANY DETAIL — FINAL UI POLISH
   ========================================================= */

.company-status-block {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 14px;
}

.company-status-value {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.05em;
}

.company-status-action {
  margin-top: 0;
  margin-left: 24px;
}

.company-status-block + .company-status-action {
  display: inline-flex;
  vertical-align: middle;
}

.company-overview-panel,
.business-modules-panel {
  margin-top: 16px;
}

.company-overview-panel {
  padding-bottom: 24px;
}

.business-modules-panel {
  padding-bottom: 12px;
}

.section-heading {
  margin-bottom: 14px;
}

.section-heading h3 {
  margin: 3px 0 0;
  font-size: 16px;
}

.section-heading .muted {
  margin: 5px 0 0;
  font-size: 12px;
}

/* Company information */

.company-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.company-overview-grid > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.field-label {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.company-overview-grid strong {
  font-size: 14px;
}

/* Module list */

.module-row {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) 150px 110px 140px;
  align-items: center;
  gap: 20px;
  min-height: 64px;
  padding: 12px 0;
  border-top: 1px solid #e7edf3;
}

.module-row:first-of-type {
  border-top: 0;
}

.module-row > strong {
  font-size: 14px;
}

.module-row > span {
  color: var(--muted);
  font-size: 12px;
}

.module-row > span:nth-child(3) {
  color: var(--ink);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
}

.module-row > div {
  display: flex;
  justify-content: flex-end;
}

.module-row .small-btn {
  min-width: 110px;
  white-space: nowrap;
}

/* Keep company-level buttons visually distinct from module buttons */

.company-status-action .small-btn {
  min-width: 125px;
}

/* Status/action feedback */

.panel > p {
  margin: 0;
}

/* Detail page hero */

.hero {
  margin-bottom: 18px;
}

.hero h1 {
  margin-top: 7px;
  margin-bottom: 4px;
}

/* Responsive */

@media (max-width: 900px) {
  .module-row {
    grid-template-columns: minmax(150px, 1fr) 120px 140px;
    gap: 12px;
  }

  .company-overview-grid {
    gap: 24px;
  }
}

@media (max-width: 720px) {
  .company-overview-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .module-row {
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 14px 0;
  }

  .module-row > div {
    justify-content: flex-start;
    margin-top: 4px;
  }
}



/* Company status/action horizontal row */

.company-status-row {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 14px;
}

.company-status-block {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 0;
}

.company-status-action {
  margin: 0;
}

@media (max-width: 600px) {
  .company-status-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }
}



/* =========================================================
   SYSTEM HOME KPI POLISH
   Matches the classes used by the SystemHome JSX.
   ========================================================= */

.system-home .kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.system-home .kpi-card {
  min-height: 132px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  text-align: left;
  border: 1px solid #d5e0eb;
  border-radius: 10px;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.system-home .kpi-card:hover {
  transform: translateY(-1px);
  border-color: #b8cce2;
  box-shadow: var(--shadow-md);
}

.system-home .kpi-label {
  color: #58718e;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.system-home .kpi-value {
  display: block;
  margin-top: 10px;
  color: var(--ink);
  font-size: 28px;
  line-height: 1;
  font-weight: 700;
}

.system-home .kpi-secondary {
  display: block;
  margin-top: 9px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.4;
}

.system-home .kpi-drill {
  display: block;
  margin-top: auto;
  padding-top: 12px;
  color: var(--blue);
  font-size: 12px;
  font-weight: 600;
}

.system-home .kpi-card.disabled {
  cursor: default;
}

.system-home .kpi-card.disabled:hover {
  transform: none;
  border-color: #d5e0eb;
  box-shadow: var(--shadow-sm);
}

.system-home .kpi-card.disabled .kpi-value {
  color: #71849a;
}

@media (max-width: 1100px) {
  .system-home .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .system-home .kpi-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   SYSTEM HOME — COMPLETE VISUAL POLISH
   ========================================================= */

.dashboard-sections {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px;
  margin-top: 16px;
}

.dashboard-sections > .panel {
  margin-bottom: 0;
  min-width: 0;
}

/* ---------------------------------------------------------
   Shared panel treatment
   --------------------------------------------------------- */

.dashboard-sections .panel {
  padding: 20px 22px;
}

.dashboard-sections .panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 16px;
}

.dashboard-sections .panel-heading h3 {
  margin: 4px 0 0;
  font-size: 15px;
  line-height: 1.3;
}

.dashboard-sections .panel-heading .eyebrow {
  display: block;
}

.dashboard-sections .text-button {
  flex: 0 0 auto;
  margin-top: 2px;
}

/* ---------------------------------------------------------
   Platform status
   --------------------------------------------------------- */

.dashboard-sections .status-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 20px;

  min-height: 42px;
  padding: 9px 0;

  border-top: 1px solid var(--border-light);
}

.dashboard-sections .status-row:first-of-type {
  border-top: 0;
}

.dashboard-sections .status-row span {
  color: var(--muted);
  font-size: 12px;
}

.dashboard-sections .status-row strong {
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
  text-align: right;
}

.dashboard-sections .status-badge {
  padding: 5px 9px;
  margin-top: 1px;
}

/* ---------------------------------------------------------
   Recent companies
   --------------------------------------------------------- */

.dashboard-sections .activity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;

  min-height: 52px;
  padding: 8px 0;

  border-top: 1px solid var(--border-light);
}

.dashboard-sections .activity-row:first-of-type {
  border-top: 0;
}

.dashboard-sections .activity-row > div {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.dashboard-sections .activity-row strong {
  color: var(--ink);
  font-size: 13px;
  line-height: 1.3;
}

.dashboard-sections .activity-row > div span {
  color: var(--muted);
  font-size: 11px;
}

.dashboard-sections .activity-row .status-badge {
  flex: 0 0 auto;
}

/* ---------------------------------------------------------
   Recent activity
   --------------------------------------------------------- */

.dashboard-sections > .panel:last-child {
  grid-column: 1 / -1;
}

.dashboard-sections > .panel:last-child .panel-heading {
  margin-bottom: 12px;
}

.dashboard-sections > .panel:last-child p {
  margin: 0;
}

.dashboard-sections > .panel:last-child p.muted {
  max-width: 760px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

/* ---------------------------------------------------------
   Empty/loading states
   --------------------------------------------------------- */

.dashboard-sections .muted {
  color: var(--muted);
  font-size: 12px;
}

/* ---------------------------------------------------------
   Responsive
   --------------------------------------------------------- */

@media (max-width: 850px) {
  .dashboard-sections {
    grid-template-columns: 1fr;
  }

  .dashboard-sections > .panel:last-child {
    grid-column: auto;
  }
}

@media (max-width: 560px) {
  .dashboard-sections .panel {
    padding: 18px;
  }

  .dashboard-sections .panel-heading {
    flex-direction: column;
    gap: 10px;
  }

  .dashboard-sections .activity-row {
    align-items: flex-start;
  }
}

/* PHOENIX SYSTEM USERS */

/* PHOENIX SYSTEM USERS */

.system-users-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(360px, 0.75fr);
  gap: 20px;
  align-items: start;
}

.system-users-layout .panel {
  min-width: 0;
}

.system-users-layout .panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 16px;
}

.system-users-layout .panel-heading h3 {
  margin: 0 0 4px;
}

.system-users-layout .panel-heading span {
  color: #64748b;
  font-size: 13px;
}

.search-input {
  width: 205px;
  min-height: 40px;
  padding: 0 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #0b2545;
  font: inherit;
  outline: none;
}

.search-input:focus,
.form-stack input:focus {
  border-color: #2b5d91;
  box-shadow: 0 0 0 3px rgba(43, 93, 145, 0.12);
}

.user-table {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.user-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 16px;
  border: 1px solid #dbe3ec;
  border-radius: 10px;
  background: #ffffff;
  color: #0b2545;
  text-align: left;
  cursor: pointer;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease;
}

.user-row:hover {
  border-color: #9fb5ca;
  box-shadow: 0 3px 10px rgba(11, 37, 69, 0.06);
}

.user-row.selected {
  border-color: #2b5d91;
  background: #f4f8fc;
  box-shadow: 0 0 0 1px #2b5d91;
}

.user-row-main {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.user-row-main strong {
  font-size: 14px;
}

.user-row-main span {
  color: #64748b;
  font-size: 13px;
}

.user-row-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 6px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 26px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.status-pill.active {
  background: #e7f6ed;
  color: #187341;
}

.status-pill.suspended {
  background: #fcebea;
  color: #a33a32;
}

.status-pill.reset {
  background: #fff4d6;
  color: #8a6100;
}

.detail-panel {
  min-height: 330px;
}

.detail-empty {
  min-height: 290px;
}

.detail-empty span {
  margin-top: 7px;
  color: #64748b;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.detail-header h2 {
  margin: 5px 0 4px;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid #e2e8f0;
}

.detail-grid > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.detail-grid span {
  color: #64748b;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.detail-grid strong {
  color: #0b2545;
  font-size: 14px;
}

.action-group {
  margin-top: 26px;
  padding-top: 20px;
  border-top: 1px solid #e2e8f0;
}

.action-group h3 {
  margin: 0 0 12px;
  font-size: 14px;
}

.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 38px;
  padding: 0 14px;
  border-radius: 7px;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.primary-button {
  border: 1px solid #164a78;
  background: #164a78;
  color: #ffffff;
}

.primary-button:hover {
  background: #0f3d64;
  border-color: #0f3d64;
}

.secondary-button {
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #173b63;
}

.secondary-button:hover {
  border-color: #8fa7bd;
  background: #f7f9fb;
}

.danger-button {
  border: 1px solid #d7a09b;
  background: #ffffff;
  color: #a33a32;
}

.danger-button:hover {
  background: #fdf2f1;
  border-color: #bd7770;
}

.primary-button:disabled,
.secondary-button:disabled,
.danger-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.error-banner {
  margin-bottom: 16px;
  padding: 12px 14px;
  border: 1px solid #e4b4b0;
  border-radius: 8px;
  background: #fff5f4;
  color: #96352e;
  font-size: 13px;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 120px;
  color: #64748b;
  text-align: center;
  font-size: 13px;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(5, 22, 40, 0.42);
}

.modal-card {
  width: min(520px, 100%);
  padding: 24px;
  border: 1px solid #dbe3ec;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 20px 55px rgba(5, 22, 40, 0.22);
}

.icon-button {
  width: 34px;
  height: 34px;
  border: 1px solid #d5dee8;
  border-radius: 7px;
  background: #ffffff;
  color: #526579;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}

.icon-button:hover {
  background: #f5f8fb;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 24px;
}

.form-stack label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #334e68;
  font-size: 13px;
  font-weight: 600;
}

.form-stack input {
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #0b2545;
  font: inherit;
  outline: none;
}

.modal-actions {
  justify-content: flex-end;
  margin-top: 24px;
}

@media (max-width: 980px) {
  .system-users-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .system-users-layout .panel-heading,
  .user-row,
  .detail-header {
    align-items: stretch;
    flex-direction: column;
  }

  .search-input {
    width: 100%;
  }

  .user-row-meta {
    justify-content: flex-start;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
